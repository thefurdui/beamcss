---
import github from './assets/github.svg?raw'
import { NAV, SITE } from '../../lib/site'
import BeamMark from '../BeamMark/BeamMark.astro'
import RawSvg from '../RawSvg/RawSvg.astro'
import ThemeToggle from '../ThemeToggle/ThemeToggle.astro'
import './SiteHeader.css'

const path = Astro.url.pathname

const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href))
---

<header class="site_header">
  <div class="l_container" data-size="page">
    <div class="l_cluster" data-gap="4" data-justify="between" data-nowrap>
      <a class="site_header-home" href="/" aria-label={`${SITE.name} home`}>
        <BeamMark interactive />
      </a>

      <nav class="site_header-nav" aria-label="Main">
        <ul class="u_reset_list site_header-nav_list">
          {
            NAV.map((item) => (
              <li>
                <a
                  class="site_header-nav_link"
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="l_cluster" data-gap="1" data-nowrap>
        <ThemeToggle />
        <a class="site_header-icon_link" href={SITE.repo} rel="noreferrer noopener" aria-label="Source on GitHub">
          <span class="g_icon_box">
            <RawSvg content={github} aria-hidden="true" />
          </span>
        </a>
      </div>
    </div>
  </div>
</header>
