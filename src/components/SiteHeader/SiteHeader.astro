---
import { NAV, SITE } from '../../lib/site'
import BeamMark from '../BeamMark/BeamMark.astro'
import ThemeToggle from '../ThemeToggle/ThemeToggle.astro'
import './SiteHeader.css'

const path = Astro.url.pathname
---

<header class="site_header">
  <div class="l_container" data-size="page">
    <div class="l_cluster" data-gap="4" data-justify="between" data-nowrap>
      <a class="site_header-home" href="/" aria-label={`${SITE.name} home`}>
        <BeamMark />
      </a>

      <nav class="site_header-nav" aria-label="Main">
        <ul class="u_reset_list site_header-nav_list">
          {
            NAV.map((item) => (
              <li>
                <a
                  class="site_header-nav_link"
                  href={item.href}
                  aria-current={path.startsWith(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="l_cluster" data-gap="1" data-nowrap>
        <ThemeToggle />
        <a class="site_header-icon_link" href={SITE.repo} rel="noreferrer noopener" aria-label="Source on GitHub">
          <span class="g_icon_box">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-2.91-.88-2.91-2.84 0-.56.2-1.02.53-1.38-.05-.13-.23-.65.05-1.35 0 0 .55-.17 1.8.66a5.9 5.9 0 0 1 3.12 0c1.25-.84 1.8-.66 1.8-.66.28.7.1 1.22.05 1.35.33.36.53.82.53 1.38 0 1.97-1.14 2.64-2.92 2.84.29.25.55.74.55 1.5 0 1.08-.01 1.96-.01 2.23 0 .21.15.46.55.38A7.99 7.99 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</header>
