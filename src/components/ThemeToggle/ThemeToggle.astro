---
import dial from './assets/dial.svg?raw'
import RawSvg from '../RawSvg/RawSvg.astro'
import './ThemeToggle.css'
---

{
  /*
  One glyph, no theme-conditional CSS.
  A sun/moon swap would force this component to branch on an ancestor's theme
  attribute, which is exactly the duplication the switchboard exists to kill.
  A contrast dial means the same markup is correct in every theme.
*/
}
<button
  class="u_reset_button theme_toggle"
  type="button"
  title="Toggle color theme"
  aria-label="Toggle color theme"
  data-beam-theme-toggle
>
  <span class="g_icon_box theme_toggle-dial">
    <RawSvg content={dial} aria-hidden="true" />
  </span>
</button>

<script>
  const STORAGE_KEY = 'beam-theme'

  for (const toggle of document.querySelectorAll('[data-beam-theme-toggle]')) {
    toggle.addEventListener('click', () => {
      const root = document.documentElement
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark'

      root.dataset.theme = next

      try {
        localStorage.setItem(STORAGE_KEY, next)
      } catch {
        /* Storage is a nicety, not a requirement. */
      }
    })
  }
</script>
