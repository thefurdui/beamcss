---
import './BeamMark.css'

interface Props {
  /** Renders the wordmark next to the glyph. */
  label?: boolean
  class?: string
}

const { label = true, class: className } = Astro.props
---

<span class:list={['beam_mark', className]} data-labelled={label ? 'true' : undefined}>
  <svg class="beam_mark-glyph" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <path class="beam_mark-source" d="M0 17H9.2" />
    <path class="beam_mark-prism" d="M15 4 L27 26 H3 Z" />
    <g class="beam_mark-spectrum">
      <path class="beam_mark-ray" d="M20.3 11H31" />
      <path class="beam_mark-ray" d="M22.5 15H31" />
      <path class="beam_mark-ray" d="M24.7 19H31" />
      <path class="beam_mark-ray" d="M26.9 23H31" />
    </g>
  </svg>
  {label && <span class="beam_mark-wordmark">beam</span>}
</span>
