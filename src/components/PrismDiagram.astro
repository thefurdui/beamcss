---
import './PrismDiagram.css'
---

{/*
  Undifferentiated light enters. Four ordered rays leave.
  Geometry note: the beam meets the left face at x=165, exits the right face at
  x=235, and every ray radiates from that single exit node.
*/}
<div class="prism_diagram" role="img" aria-label="A beam of white light entering a prism and leaving as four ordered rays">
  <svg class="prism_diagram-canvas" viewBox="0 0 520 300" fill="none">
    <g class="prism_diagram-spectrum">
      <path class="prism_diagram-ray" pathLength="1" d="M235 150 L512 60" />
      <path class="prism_diagram-ray" pathLength="1" d="M235 150 L512 120" />
      <path class="prism_diagram-ray" pathLength="1" d="M235 150 L512 180" />
      <path class="prism_diagram-ray" pathLength="1" d="M235 150 L512 240" />
    </g>

    <path class="prism_diagram-source" pathLength="1" d="M4 150 H165" />
    <path class="prism_diagram-pulse" pathLength="1" d="M4 150 H165" />
    <path class="prism_diagram-prism" pathLength="1" d="M200 45 L270 255 H130 Z" />
    <circle class="prism_diagram-node" cx="235" cy="150" r="2.5" />
  </svg>
</div>
