---
import arrow from './assets/arrow.svg?raw'
import downloadIcon from './assets/download.svg?raw'
import RawSvg from '../RawSvg/RawSvg.astro'
import './ActionButton.css'

interface Props {
  href: string
  tone?: 'contrast' | 'outline' | 'ghost'
  download?: boolean
  external?: boolean
}

const { href, tone = 'contrast', download = false, external = false } = Astro.props
---

<a
  class="u_pressable action_button"
  href={href}
  data-tone={tone}
  download={download ? '' : undefined}
  rel={external ? 'noreferrer noopener' : undefined}
>
  <span class="action_button-label"><slot /></span>
  <span class="g_icon_box action_button-arrow" data-size="sm" aria-hidden="true">
    <RawSvg content={download ? downloadIcon : arrow} />
  </span>
</a>
