---
import ActionButton from '../../components/ActionButton/ActionButton.astro'
import CalloutBlock from '../../components/CalloutBlock/CalloutBlock.astro'
import CodeBlock from '../../components/CodeBlock/CodeBlock.astro'
import CopyCommand from '../../components/CopyCommand/CopyCommand.astro'
import DialectTabs from '../../components/DialectTabs/DialectTabs.astro'
import FluidLab from '../../components/FluidLab/FluidLab.astro'
import LawPanel from '../../components/LawPanel/LawPanel.astro'
import PainMeter from '../../components/PainMeter/PainMeter.astro'
import SectionHead from '../../components/SectionHead/SectionHead.astro'
import ThemeLab from '../../components/ThemeLab/ThemeLab.astro'
import RootLayout from '../../layouts/RootLayout.astro'
import { SITE, SURVEY } from '../../lib/site'
import './HomePage.css'

const TETRAD = [
  {
    letter: 'B',
    name: 'Block',
    syntax: '.user_card',
    gloss: 'Identity, in snake_case.',
  },
  {
    letter: 'E',
    name: 'Element',
    syntax: '.user_card-title',
    gloss: 'A part, joined by one hyphen.',
  },
  {
    letter: 'A',
    name: 'Attribute',
    syntax: '[data-state]',
    gloss: 'State, as data.',
  },
  {
    letter: 'M',
    name: 'Module',
    syntax: 'UserCard.css',
    gloss: 'One block, one file.',
  },
]

const LINEAGE = [
  {
    year: '2008',
    name: 'OOCSS',
    took: 'Separate structure from skin.',
    kept: 'Became Mass vs Void: object shape and page rhythm are different budgets.',
  },
  {
    year: '2009',
    name: 'BEM',
    took: 'Namespace every component.',
    kept: 'Kept the idea, dropped the typing tax of __ and --.',
  },
  {
    year: '2011',
    name: 'SMACSS',
    took: 'Categorize rules before you write them.',
    kept: 'Became the prefix taxonomy: l_, u_, g_, and the block itself.',
  },
  {
    year: '2014',
    name: 'CSS-in-JS',
    took: 'Scoping is not optional.',
    kept: 'Kept co-location, refused the runtime and the generated class names.',
  },
  {
    year: '2014',
    name: 'ITCSS',
    took: 'Order the cascade deliberately.',
    kept: 'Handed the job to :where() and a flat file layout instead.',
  },
  {
    year: '2017',
    name: 'Atomic / utility-first',
    took: 'Constraints beat freedom.',
    kept: 'Kept the constrained scale, put it in tokens instead of the class attribute.',
  },
  {
    year: '2020',
    name: 'CUBE CSS',
    took: 'Compose layout, do not enumerate it.',
    kept: 'Became the l_* primitives and the Binary Rule.',
  },
]

const DIALECTS = [
  {
    id: 'bem',
    label: 'BEM',
    verdict:
      'Right instinct, four extra characters per name. Nest&nbsp;<code class="g_code">&amp;__title</code>&nbsp;and&nbsp;<code class="g_code">card__title</code>&nbsp;exists nowhere in the repo.',
    samples: [
      {
        file: 'markup.html',
        lang: 'html' as const,
        code: `<article class="promo-card promo-card--featured">
  <h2 class="promo-card__title">Refraction</h2>
  <button class="promo-card__action promo-card__action--loading">
    Read
  </button>
</article>`,
      },
      {
        file: 'promo-card.scss',
        lang: 'css' as const,
        code: `.promo-card {
  &__title { font-size: 1.5rem; }

  &__action {
    &--loading { opacity: 0.5; }
  }

  &--featured { border-color: #e11d48; }
}`,
      },
    ],
  },
  {
    id: 'utility',
    label: 'Utility-first',
    verdict: 'Fast to write. The markup describes pixels. The same card in three places drifts three ways.',
    samples: [
      {
        file: 'markup.html',
        lang: 'html' as const,
        code: `<article class="flex flex-col gap-3 rounded-xl border
  border-stone-200 bg-white p-6 shadow-sm
  dark:border-stone-800 dark:bg-stone-900">
  <h2 class="text-2xl font-semibold tracking-tight
    text-stone-900 dark:text-stone-100">Refraction</h2>
</article>`,
      },
      {
        file: 'the problem',
        lang: 'text' as const,
        code: `Every color is declared twice: once light, once dark.
Every card repeats all fourteen classes.
Renaming the component renames nothing.
"Which of these 40 divs is the card?" – you, in March`,
      },
    ],
  },
  {
    id: 'cssinjs',
    label: 'CSS-in-JS',
    verdict:
      'Solved scoping, then billed a runtime for it. Styles in the JS bundle, class names hashed, CSS needs JavaScript to exist.',
    samples: [
      {
        file: 'PromoCard.tsx',
        lang: 'tsx' as const,
        code: `const Card = styled.article\`
  padding: 1.5rem;
  border: 1px solid \${(p) => p.theme.border};
  background: \${(p) => p.theme.surface};
\`

const Title = styled.h2\`
  font-size: 1.5rem;
  color: \${(p) => p.theme.ink};
\`

// Renders: <article class="sc-bdVaJa hXlkjP">`,
      },
      {
        file: 'the problem',
        lang: 'text' as const,
        code: `Devtools shows you hXlkjP.
Search cannot find a style by name.
Theme values arrive through a React context.
Your CSS is now a JavaScript dependency.`,
      },
    ],
  },
  {
    id: 'beam',
    label: 'BEAM',
    verdict: 'Identity in the class, state in the attribute, color in the token, geometry in the wrapper.',
    samples: [
      {
        file: 'PromoCard.astro',
        lang: 'html' as const,
        code: `<article class="promo_card" data-featured="true">
  <div class="l_stack" data-gap="3">
    <h2 class="promo_card-title">Refraction</h2>
    <button class="u_reset_button promo_card-action" data-state="loading">
      Read
    </button>
  </div>
</article>`,
      },
      {
        file: 'PromoCard.css',
        lang: 'css' as const,
        code: `.promo_card {
  padding: fluid(var(--space-4), var(--space-6));
  border: 1px solid var(--border-base);
  background: var(--bg-surface);
}

.promo_card[data-featured='true'] {
  border-color: var(--border-focus);
}

.promo_card-title {
  font-size: var(--text-2xl);
  color: var(--ink-main);
}

.promo_card-action[data-state='loading'] {
  opacity: var(--opacity-disabled);
}`,
      },
    ],
  },
]

const description =
  'BEAM is a strict, browser-native CSS architecture. Four class types, one file per component, state in data attributes, and color behind a four-layer firewall. No preprocessor, no runtime, no utility soup.'
---

<RootLayout title="BEAM CSS – Block. Element. Attribute. Module." description={description}>
  {/* ---------------------------------------------------------------- HERO */}
  <section class="hero_section">
    <div class="l_container" data-size="page">
      <div class="hero_section-copy">
        <div class="l_stack" data-gap="5" data-align="start">
          <span class="g_tag" data-tone="accent">v{SITE.version} · {SITE.tagline}</span>

          <h1 class="hero_section-title u_balance">CSS architecture for<br />OCD-grade determinism.</h1>

          <p class="hero_section-lede u_pretty">
            Collision-proof namespaces. One CSS file per component. State in&nbsp;<code class="g_code">data-*</code
            >&nbsp;attributes. Locked-down semantic tokens. No preprocessor, no runtime, and no&nbsp;<code
              class="g_code">div</code
            >&nbsp;wearing fourteen classes.
          </p>

          <div class="l_cluster" data-gap="3">
            <ActionButton href="#the-numbers">Why?</ActionButton>
            <ActionButton href="/spec/" tone="outline">Read the spec</ActionButton>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* -------------------------------------------------------- TETRAD STRIP */}
  <section class="tetrad_strip" aria-label="The four class types">
    <div class="l_container" data-size="page">
      <div class="l_grid" data-cols="auto" data-min="xs" data-gap="0">
        {
          TETRAD.map((law) => (
            <div class="tetrad_strip-cell">
              <div class="l_stack" data-gap="2" data-align="start">
                <span class="tetrad_strip-letter">{law.letter}</span>
                <span class="tetrad_strip-name">{law.name}</span>
                <code class="tetrad_strip-syntax">{law.syntax}</code>
                <span class="tetrad_strip-gloss">{law.gloss}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------- 01 THE NUMBERS */}
  <section class="home_section" id="the-numbers">
    <div class="l_container" data-size="page">
      <div class="l_stack" data-gap="fluid-md">
        <SectionHead
          index="01"
          eyebrow="The problem"
          title="CSS is more capable than ever, yet more confusing than ever."
          lede={`Devographics asked ${SURVEY.respondents} developers what hurts. Here\'s the freshest data:`}
        />

        <div class="l_grid" data-cols="auto" data-min="lg" data-gap="6">
          <PainMeter
            question="Top pain points – color"
            respondents="573"
            items={[
              {
                label: 'Accessibility',
                share: 27,
                note: 'Contrast, by hand, forever.',
              },
              {
                label: 'Theming',
                share: 24,
                note: 'Named cause: duplicated theme definitions.',
                solved: true,
              },
              { label: 'Cognitive overload', share: 17 },
              {
                label: 'Custom properties',
                share: 7,
                note: 'The tool meant to fix the above.',
              },
            ]}
          />

          <PainMeter
            question="Top pain points – CSS in general"
            respondents="398"
            items={[
              {
                label: 'Cognitive overload',
                share: 22,
                note: 'The number one complaint, overall.',
                solved: true,
              },
              { label: 'Tooling', share: 13 },
              {
                label: 'Maintenance',
                share: 9,
                note: 'Up 18 places from last year.',
                solved: true,
              },
              { label: 'Cascade management', share: 5 },
            ]}
          />
        </div>

        <div class="l_switcher" data-threshold="4xl" data-gap="8" data-align="start">
          <blockquote class="home_section-quote">
            <p class="home_section-quote_text">
              “Supporting light/dark mode is difficult; developers struggle to work with system preferences, manual
              theme selection, and duplicated theme definitions.”
            </p>
            <p class="home_section-quote_text">
              “Managing color palettes, tokens, variables and design-system scales is hard.”
            </p>
            <footer class="home_section-quote_source">
              <a class="home_section-quote_link" href={SURVEY.url} rel="noreferrer noopener">
                State of CSS {SURVEY.year} – color pain points, summarized from free-form answers
              </a>
            </footer>
          </blockquote>

          <div class="g_prose home_section-prose">
            <p>
              Nobody is waiting on a browser anymore. The named causes are duplicated theme definitions, palettes that
              are hard to manage, cognitive overload, and maintenance.
            </p>
            <p>That is an architecture problem. That's what we solve.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------- 02 THE LINEAGE */}
  <section class="home_section" id="lineage">
    <div class="l_container" data-size="page">
      <div class="l_stack" data-gap="fluid-md">
        <SectionHead
          index="02"
          eyebrow="Provenance"
          title="BEAM did not fall out of the sky."
          lede="Almost every idea here is borrowed. A convention nobody has seen before is a convention nobody will follow."
        />

        <ol class="u_reset_list lineage_rail">
          {
            LINEAGE.map((entry) => (
              <li class="lineage_rail-row">
                <div class="l_switcher" data-threshold="3xl" data-gap="4" data-align="start">
                  <div class="lineage_rail-marker">
                    <div class="l_cluster" data-gap="3" data-nowrap>
                      <span class="lineage_rail-year u_tabular">{entry.year}</span>
                      <span class="lineage_rail-name">{entry.name}</span>
                    </div>
                  </div>
                  <div class="lineage_rail-detail">
                    <p class="lineage_rail-took">{entry.took}</p>
                    <p class="lineage_rail-kept">{entry.kept}</p>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>

        <CalloutBlock tone="note" title="What is actually new">
          <p>
            State in attributes, not classes. A color declared twice in the whole codebase, never in a component. Naming
            chosen to respect IDE-native word boundaries. The rest is curation.
          </p>
        </CalloutBlock>

        <div class="l_cluster" data-gap="4">
          <ActionButton href="/lineage/" tone="ghost">Full comparison</ActionButton>
        </div>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------- 03 FOUR LAWS */}
  <section class="home_section" id="four-laws">
    <div class="l_container" data-size="page">
      <div class="l_stack" data-gap="fluid-md">
        <SectionHead
          index="03"
          eyebrow="The tetrad"
          title="Four letters. That's the entire principle."
          lede="A rule you have to look up is a rule you will break."
        />

        <div class="l_stack" data-gap="0">
          <LawPanel letter="B" name="Block" syntax=".snake_case" id="law-block">
            <p>
              Named for what it is.&nbsp;<code>.user_card</code>, not&nbsp;<code>.bg-white.rounded-xl.p-4</code>. When
              the fill changes,&nbsp;<code>bg-white</code>&nbsp;is a lie in forty files. A card is still a card.
            </p>
            <p>
              snake_case because&nbsp;<code>user_card</code>&nbsp;is one double-click.&nbsp;<code>id</code>&nbsp;is a
              document hook, not a styling API – specificity&nbsp;<code>1,0,0</code>, not reusable.
            </p>
            <CodeBlock
              slot="code"
              file="UserCard.css"
              lang="css"
              code={`.user_card {
  padding: var(--space-5);
  border: 1px solid var(--border-base);
  background: var(--bg-surface);
}`}
            />
          </LawPanel>

          <LawPanel letter="E" name="Element" syntax=".block-part_name" id="law-element">
            <p>
              One hyphen joins a block to its part. Underscores inside each half. The hyphen means <em>belongs to</em>,
              and nothing else. Names stay flat – they do not encode today's DOM.
            </p>
            <CodeBlock
              slot="code"
              file="NavBar.css"
              lang="css"
              code={`/* Correct: flat, one hyphen, searchable */
.nav_bar-list_item { }
.nav_bar-action_button { }

/* Wrong: the hyphen now means two different things */
.nav_bar-list-item { }

/* Wrong: encodes today's DOM into tomorrow's selector */
.nav_bar .list_item { }`}
            />
          </LawPanel>

          <LawPanel letter="A" name="Attribute" syntax="[data-state]" id="law-attribute">
            <p>
              <strong>State is data, not a class.</strong>&nbsp;<code>is-active</code>,&nbsp;<code>--active</code
              >,&nbsp;<code>.button--loading</code>,&nbsp;<code>.js-open</code> – five codebases, five dialects. Attributes
              have been around since 2008, and they are the best tool for the job. You also stop concatenating class strings
              in JavaScript.
            </p>
            <CodeBlock
              slot="code"
              file="Button.html"
              lang="html"
              code={`<button class="button" data-variant="primary" data-state="loading">
  Save
</button>`}
            />
          </LawPanel>

          <LawPanel letter="M" name="Module" syntax="UserCard.css" id="law-module">
            <p>
              One block, one file, next to the component.&nbsp;<code>UserCard.tsx</code>&nbsp;and&nbsp;<code
                >UserCard.css</code
              >&nbsp;live and die together. No orphans. No four-thousand-line&nbsp;<code>components.css</code>. The
              exceptions are big components, implementing full pages, like&nbsp;<code>index.astro</code>&nbsp;
            </p>
            <CodeBlock
              slot="code"
              file="tree"
              lang="text"
              code={`src/components/
  UserCard.tsx     -> renders .user_card
  UserCard.css     -> styles .user_card and nothing else
  PromoBanner.tsx
  PromoBanner.css`}
            />
          </LawPanel>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------- 04 THE CURSOR */}
  <section class="home_section" id="editor">
    <div class="l_container" data-size="page">
      <div class="l_stack" data-gap="fluid-md">
        <SectionHead
          index="04"
          eyebrow="Editor optimization"
          title="The convention is designed around your cursor."
          lede="To make it work – never use the ampersand to build a class name."
        />

        <div class="l_grid" data-cols="auto" data-min="lg" data-gap="4">
          <CodeBlock
            tone="wrong"
            file="Wrong – the name does not exist"
            lang="css"
            code={`.user_card {
  &-title {
    font-size: var(--text-2xl);
  }
}`}
          />
          <CodeBlock
            tone="right"
            file="Right – the name is a real string"
            lang="css"
            code={`.user_card-title {
  font-size: var(--text-2xl);
}`}
          />
        </div>

        <div class="l_switcher" data-threshold="4xl" data-gap="8" data-align="start">
          <div class="g_prose home_section-prose">
            <p>
              In the first version,&nbsp;<code>user_card-title</code>&nbsp;exists nowhere – not in search, not in&nbsp;<code
                >rg</code
              >, not in the language server, not in a model's context window. You saved eleven characters.
            </p>
            <p>
              In the second, one string is the markup and the style.&nbsp;<span class="g_kbd">⌘</span><span
                class="g_kbd">D</span
              >&nbsp;or&nbsp;<span class="g_kbd">*</span>&nbsp;<span class="g_kbd">c</span><span class="g_kbd">g</span
              ><span class="g_kbd">n</span>&nbsp;<span class="g_kbd">.</span>&nbsp;can grab it because it is actually in
              the file.&nbsp;<code>&amp;-title</code>&nbsp;gives those keystrokes nothing. BEM's&nbsp;<code
                >&amp;__element</code
              >&nbsp;has the same hole.
            </p>
          </div>

          <CalloutBlock tone="law" title="Nesting is allowed. Concatenation is not.">
            <p>
              Nest one level for state, pseudos and queries –&nbsp;<code>&amp;:hover</code>,&nbsp;<code
                >&amp;[data-state='open']</code
              >,&nbsp;<code>@container</code>. Those are conditions, not names.
            </p>
            <p>If nesting invents a string that does not appear in the file, it is banned.</p>
          </CalloutBlock>
        </div>
      </div>
    </div>
  </section>

  {/* -------------------------------------------------------- 05 THEMING */}
  <section class="home_section" id="theming">
    <div class="l_container" data-size="page">
      <div class="l_stack" data-gap="fluid-md">
        <SectionHead
          index="05"
          eyebrow="The 24 percent"
          title="Theming, solved."
          lede="A quarter of developers named theming as a top color pain point, and the survey recorded the specific cause: duplicated theme definitions. So let's remove the duplication instead of managing it."
        />

        <div class="l_grid" data-cols="auto" data-min="lg" data-gap="6">
          <CodeBlock
            file="theme.css – Layers 1 and 2"
            lang="css"
            code={`/* 1. Foundations. Raw materials. Never used in a component. */
:root {
  --palette-white: oklch(1 0 0);
  --palette-stone-900: oklch(21.6% 0.006 56.043);
}

/* 2. Themes. What "light" and "dark" physically mean.
      Components must never touch these either. */
:root {
  --theme-light-bg-surface: var(--palette-white);
  --theme-dark-bg-surface: var(--palette-stone-900);
}`}
          />
          <CodeBlock
            file="theme.css – Layer 3, the public contract"
            lang="css"
            code={`/* 3. Semantics. The only layer a component may read. */
[data-theme='light'],
[data-theme='dark'] [data-theme='inverse'] {
  --bg-surface: var(--theme-light-bg-surface);
}

[data-theme='dark'],
[data-theme='light'] [data-theme='inverse'] {
  --bg-surface: var(--theme-dark-bg-surface);
}`}
          />
        </div>

        <div class="g_prose home_section-prose">
          <p>
            A semantic is declared twice: light block, dark block. Components read&nbsp;<code>var(--bg-surface)</code
            >&nbsp;and stop.
          </p>
          <p>
            A third theme is one more block. Inverse is one attribute on a subtree. No component has ever heard the word
            “dark.”
          </p>
        </div>

        <ThemeLab />
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------- 06 MASS AND VOID */}
  <section class="home_section" id="space">
    <div class="l_container" data-size="page">
      <div class="l_stack" data-gap="fluid-md">
        <SectionHead
          index="06"
          eyebrow="Space"
          title="Void and mass are different beasts."
          lede="padding: 1rem and width: 1rem are not the same kind of 1rem."
        />

        <div class="l_switcher" data-threshold="4xl" data-gap="8" data-align="start">
          <div class="g_prose home_section-prose">
            <p>
              <strong>Void</strong> is&nbsp;<code>margin</code>,&nbsp;<code>padding</code>,&nbsp;<code>gap</code>.
              Shared rhythm. Always&nbsp;<code>--space-*</code>.
            </p>
            <p>
              <strong>Mass</strong> is&nbsp;<code>width</code>,&nbsp;<code>height</code>,&nbsp;<code>inset</code>,
              translate. The avatar is&nbsp;<code>3rem</code>&nbsp;because the avatar is 3rem, not because&nbsp;<code
                >--space-12</code
              >&nbsp;happens to equal that. If you tighten the scale – the avatar should not become an oval.
            </p>
          </div>

          <CodeBlock
            file="Avatar.css"
            lang="css"
            code={`.profile_card {
  /* Void: shared rhythm, always a token */
  padding: var(--space-5);
  gap: var(--space-3);
}

.profile_card-avatar {
  /* Mass: this object's own shape */
  width: 3rem;
  height: 3rem;
  border-radius: var(--radius-full);
}`}
          />
        </div>

        <CalloutBlock tone="law" title="The Binary Rule">
          <p>
            A layout class and a semantic component class never share a DOM element. A vertical&nbsp;<code
              >.user_card</code
            >&nbsp;doesn't just happen to be a vertical container - layout is its defining property, it should be
            written down in CSS. Reserve the nameless&nbsp;<code>l_</code>&nbsp;layout classes for semantically
            meaningless containers.
          </p>
        </CalloutBlock>

        <div class="l_grid" data-cols="auto" data-min="lg" data-gap="4">
          <CodeBlock
            tone="wrong"
            file="Wrong – the card relies on the generic layout"
            lang="html"
            code={`<article class="l_stack user_card" data-gap="4">
  ...
</article>`}
          />
          <CodeBlock
            tone="right"
            file="Right – the card owns its own layout in CSS"
            lang="html"
            code={`<article class="user_card">
  ...
</article>
`}
          />
        </div>

        <CalloutBlock tone="law" title="Mobile-first layout">
          <p>
            In 2026 it should be a non-negotiable. Unqueried CSS is the mobile view. In media queries we define &nbsp;<code
              >min-width</code
            >&nbsp;only – never&nbsp;<code>max-width</code>&nbsp;or&nbsp;<code>width &lt; 64rem</code>.
          </p>
        </CalloutBlock>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ 07 FLUID */}
  <section class="home_section" id="fluid">
    <div class="l_container" data-size="page">
      <div class="l_stack" data-gap="fluid-md">
        <SectionHead
          index="07"
          eyebrow="Interpolation"
          title="No bloated fluid formula."
          lede="The State of CSS missing-features list asked for “simpler fluid typography primitives.” It turns out to be about forty lines of PostCSS."
        />

        <div class="l_grid" data-cols="auto" data-min="lg" data-gap="4">
          <CodeBlock
            tone="wrong"
            file="What we all copy-paste"
            lang="css"
            code={`font-size: clamp(
  2.25rem,
  calc(2.25rem + (8 - 2.25) * ((100vw - 40rem) / (80 - 40))),
  8rem
);`}
          />
          <CodeBlock
            tone="right"
            file="What you actually meant"
            lang="css"
            code={`font-size: fluid(var(--text-4xl), var(--text-9xl));`}
          />
        </div>

        <div class="g_prose home_section-prose">
          <p>
            Nobody audits the first one. The two&nbsp;<code>2.25rem</code>s drift.&nbsp;<code>fluid()</code>&nbsp;, on
            the other hand, resolves both tokens at build and emits a&nbsp;<code>clamp()</code>&nbsp;with the slope
            already computed.
          </p>
        </div>

        <FluidLab />
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------- 08 ROSETTA */}
  <section class="home_section" id="rosetta">
    <div class="l_container" data-size="page">
      <div class="l_stack" data-gap="fluid-md">
        <SectionHead
          index="08"
          eyebrow="Rosetta stone"
          title="One card, four dialects."
          lede="Same component, same design, four philosophies. Read each one and ask the only question that matters: what happens to this in eighteen months, when the person working on it has never met you?"
        />

        <DialectTabs dialects={DIALECTS} label="Compare CSS approaches" />
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------- 09 AI */}
  <section class="home_section" id="agents">
    <div class="l_container" data-size="page">
      <div class="l_stack" data-gap="fluid-md">
        <SectionHead
          index="09"
          eyebrow="Machines"
          title="CSS is the language AI is worst at. That is not a coincidence."
          lede="The 2026 survey puts AI-generated CSS at roughly 28 percent – the lowest share anywhere in the stack. Here is my theory."
        />

        <div class="l_switcher" data-threshold="4xl" data-gap="8" data-align="start">
          <div class="g_prose home_section-prose">
            <p>
              <strong>There is no ground truth to generate against.</strong> A model writing Go has a compiler. Writing SQL,
              a schema. Writing TypeScript, types. Writing CSS, it has vibes.
            </p>
            <p>
              Ask five senior engineers to name and structure a card component and you will get five answers, all
              defensible. A model trained on all five produces a sixth. Then it produces a seventh in the next file,
              because nothing told it what the sixth was.
            </p>
            <p>
              BEAM's rules are the kind machines are actually good at, because they are mechanical, strict and
              deterministic rather than tasteful.
            </p>
          </div>

          <div class="l_stack" data-gap="4">
            <CodeBlock
              file="What the agent is told"
              lang="text"
              code={`Block            snake_case, from the filename
Element          .block-part_name, always flat
Attribute        data-*, never a state class
Module           one block, one co-located file
Color            Layer 3 semantics only
Void             --space-* for margin/padding/gap
Mass             raw rem for width/height/inset
Layout           l_* on a wrapper, never the block
Selectors        classes only, never an ID
Queries          min-width only, never max-width
Nesting          one level, conditions only
Ampersand        banned for name building`}
            />
            <div class="l_cluster" data-gap="3">
              <ActionButton href="/install/#skill">Get the skill</ActionButton>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------ 10 THE HONEST BIT */}
  <section class="home_section" id="objections">
    <div class="l_container" data-size="page">
      <div class="l_stack" data-gap="fluid-md">
        <SectionHead
          index="10"
          eyebrow="Full disclosure"
          title="What you are going to hate about it."
          lede="Every architecture doc ends with a triumphant list of benefits. Here is the other list, because you are going to find it anyway and I would rather you heard it from me."
        />

        <div class="l_grid" data-cols="auto" data-min="lg" data-gap="4">
          <div class="objection_card">
            <h3 class="objection_card-title">“It's more typing than utilities.”</h3>
            <p class="objection_card-body">
              Correct. A block plus a CSS file is slower than fourteen utilities – the first time. It is faster the
              third time you touch that component, and dramatically faster the first time you rename it. If your
              component is genuinely one-off, utilities win. Most components are not one-off.
            </p>
          </div>
          <div class="objection_card">
            <h3 class="objection_card-title">“snake_case looks strange.”</h3>
            <p class="objection_card-body">
              For about a day. Then double-clicking a class name and getting the whole class name stops feeling like a
              trick and starts feeling like the baseline. Nobody has ever asked to go back.
            </p>
          </div>
          <div class="objection_card">
            <h3 class="objection_card-title">“I want mixins.”</h3>
            <p class="objection_card-body">
              So does everyone – mixins have been in the survey's top missing features for years, and the platform is
              finally building them. Until then, custom properties cover most of it and honest duplication covers the
              rest. That is a real cost, and it is smaller than a preprocessor.
            </p>
          </div>
          <div class="objection_card">
            <h3 class="objection_card-title">“It's rigid to the point of rude.”</h3>
            <p class="objection_card-body">
              That part is load-bearing. A convention with exceptions is a convention that gets quietly abandoned in
              month three. The rules are absolute so that nobody has to relitigate them in a pull request at 6pm.
            </p>
          </div>
          <div class="objection_card">
            <h3 class="objection_card-title">“Will it stop me writing bad CSS?”</h3>
            <p class="objection_card-body">
              No. Nothing will. What it does is make bad CSS <em>visible</em> – a raw hex code, a state class, an&nbsp;<code
                class="g_code">l_</code
              >&nbsp;class riding a block. You stop arguing about taste and start pointing at rules.
            </p>
          </div>
          <div class="objection_card">
            <h3 class="objection_card-title">“Is this just BEM with extra steps?”</h3>
            <p class="objection_card-body">
              It is BEM with fewer steps, plus the two things BEM never had: state that lives in attributes, and a theme
              engine that stops color from being copy-pasted. If you already run disciplined BEM, migration is mostly a
              find-and-replace.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* -------------------------------------------------------------- CLOSING */}
  <section class="closing_section" id="start">
    <div class="l_container" data-size="page">
      <div class="l_stack" data-gap="8" data-align="center">
        <SectionHead
          align="center"
          wrap="pretty"
          eyebrow="Begin"
          title="Name things for what they are. Everything else follows."
          lede="Six stylesheets, one PostCSS plugin, and a set of rules short enough to memorize. You can convert one component this afternoon and keep the rest of your codebase exactly as it is."
        />

        <div class="l_cluster" data-gap="3" data-justify="center">
          <ActionButton href="/install/">Install BEAM</ActionButton>
          <ActionButton href="/spec/" tone="outline">Read the specification</ActionButton>
          <ActionButton href={SITE.repo} tone="outline" external>Source</ActionButton>
        </div>

        <p class="closing_section-note">
          Then open the inspector on this page. Every class you find is a Block, an Element, an&nbsp;<code
            class="g_code">l_</code
          >, a&nbsp;<code class="g_code">u_</code>, or a&nbsp;<code class="g_code">g_</code>. That is the whole
          vocabulary.
        </p>
      </div>
    </div>
  </section>
</RootLayout>
