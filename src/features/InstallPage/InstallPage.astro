---
import ActionButton from '../../components/ActionButton/ActionButton.astro'
import CalloutBlock from '../../components/CalloutBlock/CalloutBlock.astro'
import CodeBlock from '../../components/CodeBlock/CodeBlock.astro'
import CopyCommand from '../../components/CopyCommand/CopyCommand.astro'
import SectionHead from '../../components/SectionHead/SectionHead.astro'
import SpecTable from '../../components/SpecTable/SpecTable.astro'
import RootLayout from '../../layouts/RootLayout.astro'
import { SITE } from '../../lib/site'
import './InstallPage.css'

const STARTER_FILES: { file: string; owns: string; href?: string }[] = [
  {
    file: 'fonts.css',
    owns: '@font-face or stylesheet imports and nothing else.',
    href: SITE.fontsManualCss,
  },
  { file: 'reset.css', owns: 'Browser normalization. No classes, by rule.' },
  {
    file: 'theme.css',
    owns: 'All three token layers. The only file that knows a color.',
  },
  { file: 'layout.css', owns: 'The l_* primitives.' },
  { file: 'utils.css', owns: 'The u_* zero-state behaviors.' },
  { file: 'generics.css', owns: 'The g_* global visual objects.' },
]

const AGENTS = [
  { tool: 'Claude', path: '.claude/skills/beam-css/' },
  { tool: 'Codex', path: '.codex/skills/beam-css/' },
  { tool: 'Cursor', path: '.cursor/skills/beam-css/' },
  {
    tool: 'Others',
    path: 'Point it at the three files, or paste SKILL.md into your system prompt.',
  },
]

const description =
  'Install BEAM CSS: download the five required global stylesheets, add the postcss-beam-fluid plugin, and drop the agent skill into Cursor, Claude Code or Codex.'
---

<RootLayout title="Install – BEAM CSS" description={description}>
  <div class="install_page">
    <div class="l_container" data-size="page">
      <header class="install_page-masthead">
        <div class="l_stack" data-gap="5" data-align="start">
          <span class="g_tag" data-tone="accent">v{SITE.version}</span>
          <h1 class="install_page-title u_balance">Pure stylesheets.<br />No required depencencies.</h1>
          <p class="install_page-lede u_pretty">
            BEAM ships as plain CSS you own, one optional build-time plugin for fluid styling, and a skill for your
            agents. Nothing else.
          </p>
          <div class="l_cluster" data-gap="3">
            <ActionButton href="#stylesheets">Start with the stylesheets</ActionButton>
            <ActionButton href={SITE.repo} tone="outline">View source</ActionButton>
          </div>
        </div>
      </header>

      {/* ------------------------------------------------------- STYLESHEETS */}
      <section class="install_page-section" id="stylesheets">
        <div class="l_stack" data-gap="fluid-md">
          <SectionHead
            index="01"
            eyebrow="The global layer"
            title="Six files. That's it."
            lede="These are the exact stylesheets this website is wearing. Not a sanitized example – the real ones, copied out of src/styles at build time so they cannot drift from what you are looking at."
          />

          <div class="l_grid" data-cols="auto" data-min="xl" data-gap="8">
            <div class="l_stack" data-gap="5">
              <SpecTable
                lead="wide"
                head={['File', 'Owns']}
                rows={STARTER_FILES.map((entry) => [`<code>${entry.file}</code>`, entry.owns])}
              />

              <div class="l_cluster" data-gap="2">
                {
                  STARTER_FILES.map((entry) => (
                    <a
                      class="install_page-file_link"
                      href={entry.href ?? `/starter/${entry.file}`}
                      download={entry.href ? undefined : true}
                      target={entry.href ? '_blank' : undefined}
                      rel={entry.href ? 'noreferrer noopener' : undefined}
                    >
                      <span class="install_page-file_name">{entry.file}</span>
                      <span class="install_page-file_hint" aria-hidden="true">
                        {entry.href ? '↗' : '↓'}
                      </span>
                    </a>
                  ))
                }
              </div>
            </div>

            <div class="l_stack" data-gap="5">
              <CodeBlock
                file="Grab all five"
                lang="bash"
                code={`mkdir -p src/styles && cd src/styles

for f in reset theme layout utils generics; do
  curl -sO https://beamcss.org/starter/$f.css
done`}
              />

              <CodeBlock
                file="Import them in this order"
                lang="css"
                code={`/* Order is load-bearing: faces before anything
   asks for them, resets before tokens, tokens
   before anything that reads them. */
@import './fonts.css'; /* skip on system fonts, or when faces load in the head */
@import './reset.css';
@import './theme.css';
@import './layout.css';
@import './utils.css';
@import './generics.css';`}
              />
            </div>
          </div>
          <CalloutBlock tone="note" title="Now make them yours">
            <p>
              The palette in&nbsp;<code>theme.css</code>&nbsp;is a warm neutral stone ramp and a refracted vermilion.
              Yours will be different. Change the&nbsp;<code>--palette-*</code>&nbsp;values, adjust the two&nbsp;<code
                >--theme-*</code
              >&nbsp;blocks to taste, and leave Layer 3 alone – that is the contract every component you ever write is
              going to read.
            </p>
          </CalloutBlock>

          <CalloutBlock tone="note" title="When to skip fonts.css">
            <p>
              <code>fonts.css</code>&nbsp;holds&nbsp;<code>@font-face</code>&nbsp; or font imports and nothing else. It
              is not in the five-file download because the faces you load are yours, and a stylesheet that 404s is a
              worse gift than no stylesheet. Declaring the files is this file's job; deciding what they <em>mean</em> is&nbsp;<code
                >theme.css</code
              >'s job via&nbsp;<code>--typeface-*</code>.
            </p>
            <p>
              Skip it only in two cases: the product is on system fonts, or the faces are already loaded outside CSS – a
              Google Fonts&nbsp;<code>&lt;link&gt;</code>&nbsp;in the document head, for example.
            </p>
            <p>
              If you self-host and care about FOUC, write&nbsp;<code>@font-face</code>&nbsp;here and preload the files
              so the first paint is already typeset. That is what this site does.&nbsp;<a
                href={SITE.fontsManualCss}
                target="_blank">This fonts.css</a
              >&nbsp;is a worked example of that path: the files are imported by hand so they can be preloaded.
            </p>
            <p>
              If FOUC is not a problem for you and you don't need to preload the font-faces, you can go the easier way
              and import the stylesheets from Fontsource packages.&nbsp;<a
                href={SITE.fontsFontsourceCss}
                target="_blank">This fonts.css</a
              >&nbsp; version shows this approach.
            </p>
          </CalloutBlock>
        </div>
      </section>

      {/* ------------------------------------------------------------ PLUGIN */}
      <section class="install_page-section" id="plugin">
        <div class="l_stack" data-gap="fluid-md">
          <SectionHead
            index="02"
            eyebrow="The one dependency"
            title="@beam-css/postcss-fluid"
            lede="It turns fluid(min, max) into a clamp() with the slope pre-computed. That is the entire scope of the package."
          />

          <div class="l_grid" data-cols="auto" data-min="lg" data-gap="4">
            <CopyCommand label="pnpm" command="pnpm add -D @beam-css/postcss-fluid" />
            <CopyCommand label="npm" command="npm install --save-dev @beam-css/postcss-fluid" />
          </div>

          <div class="l_grid" data-cols="auto" data-min="xl" data-gap="4">
            <CodeBlock
              file="postcss.config.mjs"
              lang="tsx"
              code={`import postcssBeamFluid from '@beam-css/postcss-fluid'

export default {
  plugins: [
    postcssBeamFluid({
      minViewport: '40rem',
      maxViewport: '80rem',
      tokenFiles: ['src/styles/theme.css'],
    }),
  ],
}`}
            />

            <CodeBlock
              file="What you write / what ships"
              lang="css"
              code={`/* authored */
.hero_title {
  font-size: fluid(var(--text-4xl), var(--text-8xl));
}

/* built */
.hero_title {
  font-size: clamp(2.25rem, -1.5rem + 9.375vw, 6rem);
}`}
            />
          </div>

          <SpecTable
            head={['Option', 'Default', 'What it does']}
            rows={[
              [
                '<code>minViewport</code>',
                '<code>20rem</code>',
                'Viewport width at which the minimum value is reached.',
              ],
              [
                '<code>maxViewport</code>',
                '<code>80rem</code>',
                'Viewport width at which the maximum value is reached.',
              ],
              [
                '<code>tokenFiles</code>',
                '<code>[]</code>',
                'Stylesheets to scan for&nbsp;<code>--custom-property</code>&nbsp;declarations, so&nbsp;<code>fluid(var(--space-4), var(--space-8))</code>&nbsp;resolves.',
              ],
              [
                '<code>tokens</code>',
                '<code>{}</code>',
                'Inline token map. Wins over&nbsp;<code>tokenFiles</code>, which is handy in tests.',
              ],
              [
                '<code>precision</code>',
                '<code>4</code>',
                'Decimal places in the emitted math. Four is plenty; more is noise.',
              ],
            ]}
          />

          <div class="g_prose install_page-prose">
            <p>
              Per-call bounds override the project defaults when a single element needs a different curve:&nbsp;<code
                >fluid(2rem, 8rem, 20rem, 60rem)</code
              >. Anything the plugin cannot resolve statically –&nbsp;<code>em</code>,&nbsp;<code>%</code>, a mixed-unit
              pair, a token that does not exist – throws and fails the build. That is deliberate. A wrong font size that
              nobody notices for three months is a worse outcome than a red pipeline.
            </p>
          </div>

          <CodeBlock file="Trust, then verify" lang="bash" code={`pnpm build && ! rg -q "fluid\\(" dist`} />
        </div>
      </section>

      {/* ------------------------------------------------------------- SKILL */}
      <section class="install_page-section" id="skill">
        <div class="l_stack" data-gap="fluid-md">
          <SectionHead
            index="03"
            eyebrow="For the machine"
            title="The agent skill."
            lede="Three markdown files: the rules, the token catalog, and worked examples with their anti-patterns. Drop them where your agent looks for skills and it will write BEAM without being reminded – and review its own diff against the same checklist you would use."
          />

          <div class="l_grid" data-cols="auto" data-min="xl" data-gap="8">
            <div class="l_stack" data-gap="4">
              <a class="install_page-artifact" href="/skill/SKILL.md" download>
                <div class="l_cluster" data-gap="4" data-justify="between" data-nowrap>
                  <span class="l_stack" data-gap="1">
                    <span class="install_page-artifact_name">SKILL.md</span>
                    <span class="install_page-artifact_note">The rules, the taxonomy, the review checklist.</span>
                  </span>
                  <span class="install_page-artifact_size u_tabular">10 KB</span>
                </div>
              </a>

              <a class="install_page-artifact" href="/skill/reference.md" download>
                <div class="l_cluster" data-gap="4" data-justify="between" data-nowrap>
                  <span class="l_stack" data-gap="1">
                    <span class="install_page-artifact_name">reference.md</span>
                    <span class="install_page-artifact_note">Every token, every layout attribute, plugin options.</span>
                  </span>
                  <span class="install_page-artifact_size u_tabular">10 KB</span>
                </div>
              </a>

              <a class="install_page-artifact" href="/skill/examples.md" download>
                <div class="l_cluster" data-gap="4" data-justify="between" data-nowrap>
                  <span class="l_stack" data-gap="1">
                    <span class="install_page-artifact_name">examples.md</span>
                    <span class="install_page-artifact_note">Compliant components, plus the wrong version of each.</span
                    >
                  </span>
                  <span class="install_page-artifact_size u_tabular">9 KB</span>
                </div>
              </a>
            </div>

            <div class="l_stack" data-gap="5">
              <CodeBlock
                file="Install into a repo"
                lang="bash"
                code={`mkdir -p .cursor/skills/beam-css && cd $_

for f in SKILL.md reference.md examples.md; do
  curl -sO https://beamcss.org/skill/$f
done`}
              />

              <SpecTable
                lead="wide"
                head={['Agent', 'Where it goes']}
                rows={AGENTS.map((entry) => [entry.tool, `<code>${entry.path}</code>`])}
              />
            </div>
          </div>
        </div>
      </section>

      {/* ------------------------------------------------------------- FIRST */}
      <section class="install_page-section" id="first">
        <div class="l_stack" data-gap="fluid-md">
          <SectionHead
            index="04"
            eyebrow="Ship something"
            title="Your first component."
            lede="The whole architecture, in twenty lines. If this reads obvious to you, you already know BEAM – the rest of the specification is just the same idea applied consistently."
          />

          <div class="l_grid" data-cols="auto" data-min="xl" data-gap="4">
            <CodeBlock
              file="ProfileCard.astro"
              lang="html"
              code={`<article class="profile_card" data-featured="true">
  <img class="profile_card-avatar" src={src} alt="" />

  <div class="l_stack" data-gap="1">
    <h3 class="profile_card-name">{name}</h3>
    <p class="profile_card-role">{role}</p>
  </div>
</article>`}
            />

            <CodeBlock
              file="ProfileCard.css"
              lang="css"
              code={`.profile_card {
  display: flex;
  gap: var(--space-4);
  padding: var(--space-4);
  border: 1px solid var(--border-base);
  border-radius: var(--radius-lg);
  background: var(--bg-surface);
}

.profile_card[data-featured='true'] {
  border-color: var(--border-focus);
}

.profile_card-avatar {
  width: 3rem;
  height: 3rem;
  border-radius: var(--radius-full);
}

.profile_card-name {
  color: var(--ink-main);
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
}

.profile_card-role {
  color: var(--ink-muted);
  font-size: var(--text-sm);
}`}
            />
          </div>

          <div class="g_prose install_page-prose">
            <p>
              Read it once more and notice what is absent. No color. No breakpoint. No&nbsp;<code>dark:</code
              >&nbsp;anything. No margin reaching out to push a neighbor around. The card describes itself and nothing
              else, which is why you can drop it into a sidebar, a modal or an inverted footer and it will simply
              behave.
            </p>
          </div>

          <div class="l_cluster" data-gap="3">
            <ActionButton href="/spec/">Read the full specification</ActionButton>
            <ActionButton href="/lineage/" tone="outline">See how it compares</ActionButton>
          </div>
        </div>
      </section>
    </div>
  </div>
</RootLayout>
