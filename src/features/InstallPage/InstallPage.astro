---
import ActionButton from '../../components/ActionButton/ActionButton.astro'
import CalloutBlock from '../../components/CalloutBlock/CalloutBlock.astro'
import CodeBlock from '../../components/CodeBlock/CodeBlock.astro'
import CopyCommand from '../../components/CopyCommand/CopyCommand.astro'
import SectionHead from '../../components/SectionHead/SectionHead.astro'
import SpecTable from '../../components/SpecTable/SpecTable.astro'
import RootLayout from '../../layouts/RootLayout.astro'
import { SITE } from '../../lib/site'
import './InstallPage.css'

const STARTER_FILES = [
  { file: 'reset.css', owns: 'Browser normalization. No classes, by rule.' },
  {
    file: 'theme.css',
    owns: 'All three token layers. The only file that knows a color.',
  },
  { file: 'layout.css', owns: 'The l_* primitives.' },
  { file: 'utils.css', owns: 'The u_* zero-state behaviors.' },
  { file: 'generics.css', owns: 'The g_* global visual objects.' },
]

const AGENTS = [
  { tool: 'Cursor', path: '.cursor/skills/beam-css/' },
  { tool: 'Claude Code', path: '.claude/skills/beam-css/' },
  { tool: 'Codex', path: '.codex/skills/beam-css/' },
  {
    tool: 'Anything else',
    path: 'Point it at the three files, or paste SKILL.md into your system prompt.',
  },
]

const description =
  'Install BEAM CSS: download the five required global stylesheets, add the postcss-beam-fluid plugin, and drop the agent skill into Cursor, Claude Code or Codex.'
---

<RootLayout title="Install – BEAM CSS" description={description}>
  <div class="install_page">
    <div class="l_container" data-size="page">
      <header class="install_page-masthead">
        <div class="l_stack" data-gap="5" data-align="start">
          <span class="g_tag" data-tone="accent">v{SITE.version}</span>
          <h1 class="install_page-title u_balance">Three things to install. None of them is a framework.</h1>
          <p class="install_page-lede u_pretty">
            BEAM ships as plain CSS you own, one build-time plugin that does arithmetic, and a text file that teaches
            your coding agent the rules. There is no runtime, no config object, and nothing to keep up to date. If you
            delete the plugin tomorrow, your stylesheets still work – you just have to write your own&nbsp;<code
              >clamp()</code
            >.
          </p>
          <div class="l_cluster" data-gap="3">
            <ActionButton href="#stylesheets">Start with the stylesheets</ActionButton>
            <ActionButton href={SITE.repo} tone="outline">View source</ActionButton>
          </div>
        </div>
      </header>

      {/* ------------------------------------------------------- STYLESHEETS */}
      <section class="install_page-section" id="stylesheets">
        <div class="l_stack" data-gap="fluid-md">
          <SectionHead
            index="01"
            eyebrow="The global layer"
            title="Five files you need, and one you might."
            lede="These are the exact stylesheets this website is wearing. Not a sanitized example – the real ones, copied out of src/styles at build time so they cannot drift from what you are looking at."
          />

          <div class="l_grid" data-cols="auto" data-min="xl" data-gap="8">
            <div class="l_stack" data-gap="5">
              <SpecTable
                lead="wide"
                head={['File', 'Owns']}
                rows={STARTER_FILES.map((entry) => [`<code>${entry.file}</code>`, entry.owns])}
              />

              <div class="l_cluster" data-gap="2">
                {
                  STARTER_FILES.map((entry) => (
                    <a class="install_page-file_link" href={`/starter/${entry.file}`} download>
                      <span class="install_page-file_name">{entry.file}</span>
                      <span class="install_page-file_hint" aria-hidden="true">
                        ↓
                      </span>
                    </a>
                  ))
                }
              </div>
            </div>

            <div class="l_stack" data-gap="5">
              <CodeBlock
                file="Grab all five"
                lang="bash"
                code={`mkdir -p src/styles && cd src/styles

for f in reset theme layout utils generics; do
  curl -sO https://beamcss.dev/starter/$f.css
done`}
              />

              <CodeBlock
                file="Import them in this order"
                lang="css"
                code={`/* Order is load-bearing: faces before anything
   asks for them, resets before tokens, tokens
   before anything that reads them. */
@import './fonts.css'; /* optional */
@import './reset.css';
@import './theme.css';
@import './layout.css';
@import './utils.css';
@import './generics.css';`}
              />
            </div>
          </div>

          <CalloutBlock tone="note" title="The optional sixth file">
            <p>
              <code>fonts.css</code>&nbsp;holds&nbsp;<code>@font-face</code>&nbsp;and nothing else. It is not in the
              download because this site's copy imports Fontsource packages you probably do not want, and a stylesheet
              that fails to resolve is a worse gift than no stylesheet. Write your own – declaring the files is your
              job, and deciding what they
              <em>mean</em> is&nbsp;<code>theme.css</code>'s job via&nbsp;<code>--typeface-*</code>.
            </p>
            <p>On system fonts, skip it entirely. Five files is a complete BEAM setup.</p>
          </CalloutBlock>

          <CalloutBlock tone="note" title="Now make them yours">
            <p>
              The palette in&nbsp;<code>theme.css</code>&nbsp;is a warm neutral stone ramp and a refracted vermilion.
              Yours will be different. Change the&nbsp;<code>--palette-*</code>&nbsp;values, adjust the two&nbsp;<code
                >--theme-*</code
              >&nbsp;blocks to taste, and leave Layer 3 alone – that is the contract every component you ever write is
              going to read.
            </p>
          </CalloutBlock>
        </div>
      </section>

      {/* ------------------------------------------------------------ PLUGIN */}
      <section class="install_page-section" id="plugin">
        <div class="l_stack" data-gap="fluid-md">
          <SectionHead
            index="02"
            eyebrow="The one dependency"
            title="postcss-beam-fluid"
            lede="It turns fluid(min, max) into a clamp() with the slope pre-computed. That is the entire scope of the package, and it will never grow."
          />

          <div class="l_grid" data-cols="auto" data-min="lg" data-gap="4">
            <CopyCommand label="pnpm" command="pnpm add -D postcss-beam-fluid" />
            <CopyCommand label="npm" command="npm install --save-dev postcss-beam-fluid" />
          </div>

          <div class="l_grid" data-cols="auto" data-min="xl" data-gap="4">
            <CodeBlock
              file="postcss.config.mjs"
              lang="tsx"
              code={`import postcssBeamFluid from 'postcss-beam-fluid'

export default {
  plugins: [
    postcssBeamFluid({
      minViewport: '40rem',
      maxViewport: '80rem',
      tokenFiles: ['src/styles/theme.css'],
    }),
  ],
}`}
            />

            <CodeBlock
              file="What you write, what ships"
              lang="css"
              code={`/* authored */
.hero_title {
  font-size: fluid(var(--text-4xl), var(--text-8xl));
}

/* built */
.hero_title {
  font-size: clamp(2.25rem, -1.5rem + 9.375vw, 6rem);
}`}
            />
          </div>

          <SpecTable
            head={['Option', 'Default', 'What it does']}
            rows={[
              [
                '<code>minViewport</code>',
                '<code>20rem</code>',
                'Viewport width at which the minimum value is reached.',
              ],
              [
                '<code>maxViewport</code>',
                '<code>80rem</code>',
                'Viewport width at which the maximum value is reached.',
              ],
              [
                '<code>tokenFiles</code>',
                '<code>[]</code>',
                'Stylesheets to scan for&nbsp;<code>--custom-property</code>&nbsp;declarations, so&nbsp;<code>fluid(var(--space-4), var(--space-8))</code>&nbsp;resolves.',
              ],
              [
                '<code>tokens</code>',
                '<code>{}</code>',
                'Inline token map. Wins over&nbsp;<code>tokenFiles</code>, which is handy in tests.',
              ],
              [
                '<code>precision</code>',
                '<code>4</code>',
                'Decimal places in the emitted math. Four is plenty; more is noise.',
              ],
            ]}
          />

          <div class="g_prose install_page-prose">
            <p>
              Per-call bounds override the project defaults when a single element needs a different curve:&nbsp;<code
                >fluid(2rem, 8rem, 20rem, 60rem)</code
              >. Anything the plugin cannot resolve statically –&nbsp;<code>em</code>,&nbsp;<code>%</code>, a mixed-unit
              pair, a token that does not exist – throws and fails the build. That is deliberate. A wrong font size that
              nobody notices for three months is a worse outcome than a red pipeline.
            </p>
          </div>

          <CodeBlock file="Trust, then verify" lang="bash" code={`pnpm build && ! rg -q "fluid\\(" dist`} />
        </div>
      </section>

      {/* ------------------------------------------------------------- SKILL */}
      <section class="install_page-section" id="skill">
        <div class="l_stack" data-gap="fluid-md">
          <SectionHead
            index="03"
            eyebrow="For the machine"
            title="The agent skill."
            lede="Three markdown files: the rules, the token catalog, and worked examples with their anti-patterns. Drop them where your assistant looks for skills and it will write BEAM without being reminded – and review its own diff against the same checklist you would use."
          />

          <div class="l_grid" data-cols="auto" data-min="xl" data-gap="8">
            <div class="l_stack" data-gap="4">
              <a class="install_page-artifact" href="/skill/SKILL.md" download>
                <div class="l_cluster" data-gap="4" data-justify="between" data-nowrap>
                  <span class="l_stack" data-gap="1">
                    <span class="install_page-artifact_name">SKILL.md</span>
                    <span class="install_page-artifact_note">The rules, the taxonomy, the review checklist.</span>
                  </span>
                  <span class="install_page-artifact_size u_tabular">10 KB</span>
                </div>
              </a>

              <a class="install_page-artifact" href="/skill/reference.md" download>
                <div class="l_cluster" data-gap="4" data-justify="between" data-nowrap>
                  <span class="l_stack" data-gap="1">
                    <span class="install_page-artifact_name">reference.md</span>
                    <span class="install_page-artifact_note">Every token, every layout attribute, plugin options.</span>
                  </span>
                  <span class="install_page-artifact_size u_tabular">10 KB</span>
                </div>
              </a>

              <a class="install_page-artifact" href="/skill/examples.md" download>
                <div class="l_cluster" data-gap="4" data-justify="between" data-nowrap>
                  <span class="l_stack" data-gap="1">
                    <span class="install_page-artifact_name">examples.md</span>
                    <span class="install_page-artifact_note">Compliant components, plus the wrong version of each.</span
                    >
                  </span>
                  <span class="install_page-artifact_size u_tabular">9 KB</span>
                </div>
              </a>
            </div>

            <div class="l_stack" data-gap="5">
              <CodeBlock
                file="Install into a repo"
                lang="bash"
                code={`mkdir -p .cursor/skills/beam-css && cd $_

for f in SKILL.md reference.md examples.md; do
  curl -sO https://beamcss.dev/skill/$f
done`}
              />

              <SpecTable
                lead="wide"
                head={['Assistant', 'Where it goes']}
                rows={AGENTS.map((entry) => [entry.tool, `<code>${entry.path}</code>`])}
              />
            </div>
          </div>

          <CalloutBlock tone="law" title="Commit the skill">
            <p>
              Put it in the repository, not in your home directory. A convention that only exists on one machine is a
              preference; a convention in&nbsp;<code>.cursor/skills/</code>&nbsp;is something every contributor and
              every agent inherits on clone. This is the cheapest architectural decision on the page.
            </p>
          </CalloutBlock>
        </div>
      </section>

      {/* ------------------------------------------------------------ EDITOR */}
      <section class="install_page-section" id="editor">
        <div class="l_stack" data-gap="fluid-md">
          <SectionHead
            index="04"
            eyebrow="Ergonomics"
            title="Two minutes of editor setup."
            lede="One setting matters, and it is the same idea in every editor: a BEAM class is one word, so teach your editor that the hyphen is part of it. Neovim gets this right in CSS and wrong everywhere your markup lives."
          />

          <div class="l_grid" data-cols="auto" data-min="lg" data-gap="4">
            <CodeBlock
              file="init.lua – Neovim"
              lang="lua"
              code={`-- The css ftplugin already does iskeyword+=-, so
-- user_card-main_title is one word in a stylesheet.
-- The filetypes holding your markup do not, and
-- there * grabs 'user_card' and drops the element.
vim.api.nvim_create_autocmd('FileType', {
  pattern = {
    'html',
    'scss',
    'javascriptreact',
    'typescriptreact',
    'svelte',
    'vue',
  },
  callback = function()
    vim.opt_local.iskeyword:append('-')
  end,
})`}
            />

            <CodeBlock
              file="settings.json – VS Code"
              lang="json"
              code={JSON.stringify(
                {
                  'editor.wordSeparators': String.raw`\`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?`,
                },
                null,
                2,
              )}
            />
          </div>

          <div class="g_prose install_page-prose">
            <p>
              Both edits do one thing: remove the hyphen from the set of characters that end a word. The underscore is
              already absent from both defaults, so&nbsp;<code>user_card</code>&nbsp;was never the problem –&nbsp;<code
                >user_card-main_title</code
              >&nbsp;was, because the seam between block and element is exactly where your editor wanted to stop.
            </p>
            <p>
              Fix it and the full name becomes a single object you can grab. Double-click selects all of it.&nbsp;<span
                class="g_kbd">*</span
              >&nbsp;in Neovim searches for all of it, which is what makes&nbsp;<span class="g_kbd">c</span><span
                class="g_kbd">g</span
              ><span class="g_kbd">n</span>&nbsp;then&nbsp;<span class="g_kbd">.</span>&nbsp;a complete rename,
              and&nbsp;<span class="g_kbd">⌘</span><span class="g_kbd">D</span>&nbsp;a complete multi-select. This is
              the entire payoff of the no-concatenation rule, and it is the only editor setting BEAM will ever ask you
              for.
            </p>
            <p>
              There is a real trade-off here, so choose rather than drift. Leave the hyphen as a separator and&nbsp;<code
                >ciw</code
              >&nbsp;renames the block or the element independently, which is lovely – but&nbsp;<span class="g_kbd"
                >*</span
              >&nbsp;can then only ever search one half, and a whole-name search costs a visual selection or typing it
              out. Add the hyphen and you get the reverse. Whole-name operations are the ones you do across files, so
              that is the default worth having, but a codebase that renames elements constantly might reasonably decide
              otherwise.
            </p>
            <p>
              Beyond that, there is nothing to install. The names are plain strings, so&nbsp;<code>:grep</code>, the
              quickfix list, Telescope,&nbsp;<code>rg</code>&nbsp;and your language server's symbol list all already
              understand your stylesheet. For linting, BEAM does not ship a Stylelint plugin, because the rules worth
              automating are expressible with&nbsp;<code>selector-class-pattern</code>&nbsp;and a grep in CI. Anything
              more elaborate tends to fight you.
            </p>
          </div>

          <CodeBlock
            file=".stylelintrc.json"
            lang="json"
            code={`{
  "rules": {
    "selector-class-pattern": [
      "^(l_|u_|g_)?[a-z][a-z0-9_]*(-[a-z][a-z0-9_]*)?$",
      { "message": "Class must be snake_case, optionally block-element, optionally l_/u_/g_ prefixed" }
    ],
    "selector-max-specificity": "0,2,0",
    "selector-max-compound-selectors": 2,
    "declaration-property-value-disallowed-list": {
      "/^(margin|padding|gap)/": ["/^[0-9]/"],
      "/^(width|height|inset)/": ["/--space-/"],
      "/^transition/": ["/[0-9]+ms/", "/cubic-bezier/"]
    }
  }
}`}
          />
        </div>
      </section>

      {/* ------------------------------------------------------------- FIRST */}
      <section class="install_page-section" id="first">
        <div class="l_stack" data-gap="fluid-md">
          <SectionHead
            index="05"
            eyebrow="Ship something"
            title="Your first component."
            lede="The whole architecture, in twenty lines. If this reads obvious to you, you already know BEAM – the rest of the specification is just the same idea applied consistently."
          />

          <div class="l_grid" data-cols="auto" data-min="xl" data-gap="4">
            <CodeBlock
              file="ProfileCard.astro"
              lang="html"
              code={`<article class="profile_card" data-featured="true">
  <div class="l_cluster" data-gap="4">
    <img class="profile_card-avatar" src={src} alt="" />

    <div class="l_stack" data-gap="1">
      <h3 class="profile_card-name">{name}</h3>
      <p class="profile_card-role">{role}</p>
    </div>
  </div>
</article>`}
            />

            <CodeBlock
              file="ProfileCard.css"
              lang="css"
              code={`.profile_card {
  padding: var(--space-4);
  border: 1px solid var(--border-base);
  border-radius: var(--radius-lg);
  background: var(--bg-surface);
}

.profile_card[data-featured='true'] {
  border-color: var(--border-focus);
}

.profile_card-avatar {
  width: 3rem;
  height: 3rem;
  border-radius: var(--radius-full);
}

.profile_card-name {
  color: var(--ink-main);
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
}

.profile_card-role {
  color: var(--ink-muted);
  font-size: var(--text-sm);
}`}
            />
          </div>

          <div class="g_prose install_page-prose">
            <p>
              Read it once more and notice what is absent. No color. No breakpoint. No&nbsp;<code>dark:</code
              >&nbsp;anything. No margin reaching out to push a neighbor around. The card describes itself and nothing
              else, which is why you can drop it into a sidebar, a modal or an inverted footer and it will simply
              behave.
            </p>
          </div>

          <div class="l_cluster" data-gap="3">
            <ActionButton href="/spec/">Read the full specification</ActionButton>
            <ActionButton href="/lineage/" tone="outline">See how it compares</ActionButton>
          </div>
        </div>
      </section>
    </div>
  </div>
</RootLayout>
